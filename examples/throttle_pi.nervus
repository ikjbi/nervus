      },
      "meta": {
        "position": [
          1120,
          0.0
        ]
      }
    },
    {
      "name": "error",
      "type": "math.sum",
      "params": {
        "signs": "+-",
        "output_type": "inherit"
      },
      "meta": {
        "position": [
          160,
          0.0
        ]
      }
    },
    {
      "name": "throttle_pi",
      "type": "control.discrete_pid",
      "params": {
        "P": "Kp",
        "I": "Ki",
        "D": 0.0,
        "N": 100.0,
        "initial_integrator": 0.0,
        "upper": 100.0,
        "lower": 0.0,
