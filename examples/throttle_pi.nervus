{
  "format": "nervus-model",
  "schema_version": 4,
  "name": "throttle_pi",
  "meta": {},
  "settings": {
    "t_start": 0.0,
    "t_final": 2.0,
    "solver": "auto",
    "step": null,
    "max_step": null,
    "rtol": 1e-06,
    "atol": 1e-08,
    "zero_crossing": true
  },
  "workspace": [
    {
      "name": "Kp",
      "value": 1.5,
      "description": "Proportional gain",
      "unit": "%/°",
      "min": 0.0
    },
    {
      "name": "Ki",
      "value": 40.0,
      "description": "Integral gain",
      "unit": "%/(°·s)",
      "min": 0.0
    },
    {
      "name": "Ts",
      "value": 0.01,
      "description": "ECU task period",
      "unit": "s",
      "min": 0.001
    },
    {
      "name": "tau",
      "value": 0.05,
      "description": "Actuator time constant",
      "unit": "s",
      "min": 0.0
    },
    {
      "name": "k_act",
      "value": 0.9,
      "description": "Actuator gain",
      "unit": "°/%"
    }
  ],
  "blocks": [
    {
      "name": "target_angle",
      "type": "sources.from_workspace",
      "params": {
        "time": [
          0.0,
          0.2,
          1.2
        ],
        "data": [
          5.0,
          60.0,
          20.0
        ],
        "csv_file": "",
