    {
      "name": "battery_power_W",
      "type": "user.python_function",
      "params": {
        "code": "def f(t, wheel_power):\n    \"\"\"Battery power [W] for a wheel power [W]: losses when driving, partial recovery when braking, and the\n    auxiliaries. p = [eta_drive, eta_regen, regen_share, P_aux, P_heater]\"\"\"\n    if wheel_power >= 0.0:\n        drive = wheel_power / p[0]\n    else:\n        drive = wheel_power * p[1] * p[2]\n    return drive + p[3] + p[4]\n",
        "num_inputs": 1,
        "num_outputs": 1,
        "output_width": -1,
        "parameters": "[eta_drive, eta_regen, regen_share, P_aux, P_heater]"
      },
      "meta": {
        "position": [
          820.0,
          420.0
        ]
      }
