  "tests": [
    {
      "name": "driver follows the cycle",
      "description": "The speed stays within ±2 km/h of the cycle, and the distance matches the 994 m of ECE-15",
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "driver/tracking_error_kmh",
          "lower": -2.0,
          "upper": 2.0
        },
        {
          "kind": "final_value",
          "signal": "vehicle/distance",
          "value": 994.0,
          "tolerance": 10.0
        }
      ]
    },
    {
      "name": "wheel energy of the 1300 kg car",
      "description": "About 340 kJ for one ECE-15 cycle (9.5 kWh/100 km)",
      "inputs": {},
      "checks": [
