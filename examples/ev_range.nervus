          {
            "name": "wheel_force",
            "type": "user.python_function",
            "params": {
              "code": "def f(t, pedal, v):\n    \"\"\"Wheel force [N] from the pedal (-1 brake .. +1 throttle). p = [F_max N, P_max W, F_brake_max N]\"\"\"\n    if pedal >= 0:\n        return pedal * min(p[0], p[1] / max(v, 0.5))  # traction: force limit, then power limit\n    return pedal * p[2] * min(1.0, v / 0.2)  # brakes (fade out at standstill so the car does not roll back)\n",
              "num_inputs": 2,
              "num_outputs": 1,
              "output_width": -1,
              "parameters": "[F_max, P_max, F_brake_max]"
            },
            "meta": {
              "position": [
                150.0,
                0.0
              ]
            }
          },
