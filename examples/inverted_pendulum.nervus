    {
      "src": "states",
      "src_port": 0,
      "dst": "cart_position",
      "dst_port": 0
    },
    {
      "src": "states",
      "src_port": 1,
      "dst": "angle",
      "dst_port": 0
    },
    {
      "src": "states",
      "src_port": 2,
      "dst": "Terminator",
      "dst_port": 0
    },
    {
      "src": "states",
      "src_port": 3,
      "dst": "Terminator1",
      "dst_port": 0
    },
    {
      "src": "motor_limit",
      "src_port": 0,
      "dst": "motor_force",
      "dst_port": 0
    },
    {
      "src": "states",
      "src_port": 0,
      "dst": "scope",
      "dst_port": 0
    },
    {
      "src": "states",
      "src_port": 1,
      "dst": "scope",
      "dst_port": 1
    }
  ],
  "tests": [
    {
      "name": "balances and moves the cart",
      "description": "The pendulum stays within 0.15 rad of upright, and the cart reaches 0.3 m ± 1 cm after 9 s",
      "stop_time": 10.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "angle",
          "lower": -0.15,
          "upper": 0.15
        },
        {
          "kind": "bounds",
          "signal": "cart_position",
          "lower": 0.29,
          "upper": 0.31,
          "t_from": 9.0
        }
      ]
    }
  ]
}
