          380.0
        ]
      }
    },
    {
      "name": "knock_intensity",
      "type": "user.python_function",
      "params": {
        "code": "def f(t, advance, knock_limit):\n    \"\"\"Knock intensity [-]: 0 below the knock limit, then growing quickly with the advance beyond it.\"\"\"\n    over = advance - knock_limit\n    return 0.0 if over <= 0 else over * over\n",
        "num_inputs": 2,
        "num_outputs": 1,
        "output_width": -1,
        "parameters": []
      },
      "meta": {
        "position": [
          520.0,
          200.0
        ]
      }
    },
    {
      "name": "knock_sensor",
      "type": "sensors.sensor",
      "params": {
        "gain": 1.0,
        "offset": 0.0,
        "noise": 0.1,
        "delay": 0,
        "resolution": 0.0,
        "y_min": 0.0,
        "y_max": "inf",
        "fault": "none",
        "fault_time": 0.0,
        "drift_rate": 1.0,
        "seed": 7,
        "sample_time": 0.01
      },
      "meta": {
        "position": [
          660.0,
          200.0
        ]
      }
    },
    {
      "name": "spark_efficiency",
      "type": "user.python_function",
      "params": {
        "code": "def f(t, advance, mbt):\n    \"\"\"Torque efficiency of the spark timing: 1 at MBT, falling off quadratically (1 % at 3°, 4 % at 6°).\"\"\"\n    return 1.0 - 0.0011 * (advance - mbt) ** 2\n",
        "num_inputs": 2,
        "num_outputs": 1,
        "output_width": -1,
        "parameters": []
      },
      "meta": {
        "position": [
          520.0,
          360.0
        ]
      }
    },
