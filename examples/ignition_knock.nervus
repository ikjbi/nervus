  "tests": [
    {
      "name": "no knock with good fuel",
      "description": "With 95 RON the calibration keeps 3° from the knock limit: no retard",
      "stop_time": 4.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "retard",
          "lower": 0.0,
          "upper": 0.0
        }
      ]
    },
    {
      "name": "low-octane fuel: knock control finds the limit",
      "description": "The knock limit drops 6°; the ECU retards until the engine runs just at the new limit",
      "stop_time": 12.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "retard",
          "lower": 2.0,
          "upper": 9.0,
          "t_from": 8.0,
          "t_to": 12.0
        },
