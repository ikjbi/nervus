            },
            "meta": {
              "position": [
                180.0,
                120.0
              ]
            }
          },
          {
            "name": "use_if_valid",
            "type": "routing.switch",
            "params": {
              "criterion": "u1 >= threshold",
              "threshold": 0.5
            },
            "meta": {
              "position": [
                360.0,
                60.0
              ]
            }
          },
          {
            "name": "last_good",
            "type": "discrete.unit_delay",
            "params": {
              "initial": 0.0,
              "sample_time": 0.01
            },
            "meta": {
              "position": [
                360.0,
                200.0
              ]
            }
          },
          {
            "name": "since_valid",
            "type": "routing.switch",
            "params": {
              "criterion": "u1 >= threshold",
              "threshold": 0.5
            },
            "meta": {
              "position": [
                360.0,
                -100.0
              ]
            }
          },
          {
            "name": "since_prev",
            "type": "discrete.unit_delay",
            "params": {
              "initial": 0.0,
              "sample_time": 0.01
            },
            "meta": {
              "position": [
                360.0,
                -220.0
              ]
            }
          },
          {
            "name": "plus_period",
