        "bias": 90.0,
        "sample_time": 0.0
      },
      "meta": {
        "position": [
          0.0,
          90.0
        ]
      }
    },
    {
      "name": "ECM",
      "type": "ports.subsystem",
      "params": {
        "sample_time": 0.01,
        "enable_port": false,
        "when_enabled": "held",
        "trigger": "none"
      },
      "meta": {
        "position": [
          300.0,
          20.0
        ]
      },
      "system": {
        "blocks": [
          {
            "name": "engine_rpm",
            "type": "ports.inport",
            "params": {
              "port": 1,
              "value": 0.0,
              "sample_time": -1.0,
              "output_type": "double"
            },
            "meta": {
              "position": [
                0.0,
                0.0
              ]
            }
          },
          {
            "name": "coolant_temp",
            "type": "ports.inport",
            "params": {
              "port": 2,
              "value": 0.0,
              "sample_time": -1.0,
              "output_type": "double"
            },
            "meta": {
              "position": [
                0.0,
                80.0
              ]
            }
          },
          {
            "name": "pack",
            "type": "can.pack",
            "params": {
              "dbc_file": "data/vehicle.dbc",
              "message": "EngineData",
              "signals": "EngineSpeed, CoolantTemp"
            },
            "meta": {
              "position": [
                160.0,
                30.0
              ]
            }
          },
          {
            "name": "e2e_protect",
            "type": "can.e2e_protect",
            "params": {
              "data_id": 256,
              "crc_byte": 6,
              "counter_byte": 7,
              "sample_time": -1.0
            },
            "meta": {
              "position": [
                320.0,
                30.0
              ]
            }
          },
          {
            "name": "can_tx",
            "type": "can.transmit",
            "params": {
              "dbc_file": "data/vehicle.dbc",
              "message": "EngineData",
              "signals": "",
              "bus": "powertrain",
              "payload": "bytes",
              "mode": "periodic",
              "node": "ECM",
              "drop": 0.0,
              "delay": 0.0,
              "corrupt": "corrupt_rate",
              "bus_off": "ecm_bus_off",
              "fault_time": "corrupt_from",
              "sample_time": 0.01
            },
            "meta": {
              "position": [
                480.0,
                30.0
              ]
            }
          }
        ],
        "connections": [
          {
            "src": "engine_rpm",
            "src_port": 0,
            "dst": "pack",
            "dst_port": 0
          },
          {
            "src": "coolant_temp",
            "src_port": 0,
            "dst": "pack",
            "dst_port": 1
          },
          {
            "src": "pack",
            "src_port": 0,
            "dst": "e2e_protect",
            "dst_port": 0
          },
          {
            "src": "e2e_protect",
            "src_port": 0,
            "dst": "can_tx",
            "dst_port": 0
          }
        ]
      }
    },
