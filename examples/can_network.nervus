  "tests": [
    {
      "name": "the cluster follows the engine",
      "description": "Without faults the needle is at most 2 samples (+ the bus and gateway latency) behind the engine",
      "stop_time": 1.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "comm_lost",
          "lower": 0.0,
          "upper": 0.0
        }
      ]
    },
    {
      "name": "corrupted frames are rejected",
      "description": "With 20 % corrupted frames the E2E check rejects them; the needle never shows a corrupted value",
      "stop_time": 3.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "rpm_display",
          "lower": 1650.0,
          "upper": 3350.0,
          "t_from": 0.1
        },
        {
          "kind": "bounds",
          "signal": "comm_lost",
          "lower": 0.0,
          "upper": 0.0
        }
      ]
    },
    {
      "name": "bus-off: U0100 and the needle drops",
      "description": "The ECM goes bus-off at 3 s: after 100 ms without a valid frame the needle drops to 0 and U0100 is pending",
      "stop_time": 4.0,
      "parameters": {
        "ecm_bus_off": 1.0,
        "corrupt_rate": 0.0,
        "corrupt_from": 3.0
      },
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "comm_lost",
          "lower": 0.0,
          "upper": 0.0,
          "t_to": 3.09
        },
        {
          "kind": "bounds",
          "signal": "u0100",
          "lower": 1.0,
          "upper": 1.0,
          "t_from": 3.2
        },
        {
          "kind": "bounds",
          "signal": "rpm_display",
          "lower": 0.0,
          "upper": 0.0,
          "t_from": 3.2
        }
      ]
    }
  ]
}
