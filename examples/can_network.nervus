{
  "format": "nervus-model",
  "schema_version": 4,
  "name": "can_network",
  "meta": {},
  "settings": {
    "t_start": 0.0,
    "t_final": 4.0,
    "solver": "rk4",
    "step": 0.001,
    "max_step": null,
    "rtol": 1e-06,
    "atol": 1e-08,
    "zero_crossing": true
  },
  "workspace": [
    {
      "name": "corrupt_rate",
      "value": 0.2,
      "description": "Share of ECM frames with a flipped bit (fault injection)",
      "unit": "-"
    },
    {
      "name": "corrupt_from",
      "value": 1.0,
      "description": "When the ECM faults start",
      "unit": "s"
    },
    {
      "name": "comm_timeout",
      "value": 0.1,
      "description": "No valid EngineData for this long: communication lost",
      "unit": "s"
    },
    {
      "name": "ecm_bus_off",
      "value": 0.0,
      "description": "1: the ECM goes bus-off at corrupt_from",
      "unit": "-"
    }
  ],
  "blocks": [
    {
      "name": "engine_rpm",
      "type": "sources.sine",
      "params": {
        "amplitude": 800.0,
        "frequency": 3.0,
        "phase": 0.0,
        "bias": 2500.0,
        "sample_time": 0.0
      },
      "meta": {
        "position": [
          0.0,
          0.0
        ]
      }
    },
    {
      "name": "coolant_temp",
      "type": "sources.sine",
      "params": {
        "amplitude": 0.0,
        "frequency": 1.0,
