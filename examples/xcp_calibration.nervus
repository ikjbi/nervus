{
  "format": "nervus-model",
  "schema_version": 4,
  "name": "xcp_calibration",
  "meta": {},
  "settings": {
    "t_start": 0.0,
    "t_final": 60.0,
    "solver": "auto",
    "step": null,
    "max_step": null,
    "rtol": 1e-06,
    "atol": 1e-08,
    "zero_crossing": true,
    "pacing": 1.0
  },
  "workspace": [
    {
      "name": "m",
      "value": 1500.0,
      "description": "Vehicle mass",
      "unit": "kg"
    },
    {
      "name": "c_drag",
      "value": 8.0,
      "description": "Drag force per km/h",
      "unit": "N/(km/h)"
    },
    {
      "name": "Kp",
      "value": 300.0,
      "description": "Proportional gain",
      "unit": "N/(km/h)"
    },
    {
      "name": "Ki",
      "value": 30.0,
      "description": "Integral gain",
      "unit": "N/(km/h·s)"
    },
    {
      "name": "set_speed_cal",
      "value": 100.0,
      "description": "Set speed (calibrated over XCP)",
      "unit": "km/h",
      "min": 0.0,
      "max": 180.0
    },
    {
      "name": "gain_trim",
      "value": 1.0,
      "description": "Factor on the controller gain (calibrated over XCP)",
      "unit": "-",
      "min": 0.0,
      "max": 10.0
    }
  ],
  "blocks": [
    {
      "name": "set_speed",
      "type": "sources.step",
      "params": {
        "time": 1.0,
        "initial": 0.0,
        "final": 1.0,
        "sample_time": 0.0
      },
      "meta": {
        "position": [
          0.0,
          0.0
        ]
      }
    },
    {
      "name": "error",
      "type": "math.sum",
      "params": {
