      "meta": {
        "position": [
          150.0,
          0.0
        ]
      }
    },
    {
      "name": "cruise_control",
      "type": "control.pid",
      "params": {
        "P": "Kp",
        "I": "Ki",
        "D": 0.0,
        "N": 100.0,
        "initial_integrator": 0.0,
        "upper": 4000.0,
        "lower": -6000.0,
        "anti_windup": "clamping",
        "Kb": 1.0
      },
      "meta": {
        "position": [
          290.0,
          0.0
        ]
      }
    },
    {
      "name": "net_force",
      "type": "math.sum",
      "params": {
        "signs": "+-",
