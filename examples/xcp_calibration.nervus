      },
      "meta": {
        "position": [
          450.0,
          0.0
        ]
      }
    },
    {
      "name": "accel",
      "type": "math.gain",
      "params": {
        "gain": "3.6 / m",
        "multiplication": "elementwise",
        "output_type": "inherit"
      },
      "meta": {
        "position": [
          590.0,
          0.0
        ]
      }
    },
    {
      "name": "speed",
      "type": "continuous.integrator",
      "params": {
        "initial": 0.0,
        "upper": "inf",
        "lower": "-inf",
        "external_reset": "none",
        "initial_source": "internal",
        "saturation_port": false
      },
      "meta": {
        "position": [
          730.0,
          0.0
        ]
      }
    },
    {
      "name": "drag",
      "type": "math.gain",
      "params": {
        "gain": "c_drag",
        "multiplication": "elementwise",
        "output_type": "inherit"
      },
      "meta": {
        "position": [
          590.0,
          120.0
        ],
        "flipped": true
      }
    },
    {
      "name": "scope",
