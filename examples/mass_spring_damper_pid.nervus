{
  "format": "nervus-model",
  "schema_version": 4,
  "name": "mass_spring_damper_pid",
  "meta": {},
  "settings": {
    "t_start": 0.0,
    "t_final": 10.0,
    "solver": "auto",
    "step": null,
    "max_step": null,
    "rtol": 1e-06,
    "atol": 1e-08,
    "zero_crossing": true
  },
  "workspace": [
    {
      "name": "m",
      "value": 1.0,
      "description": "Mass",
      "unit": "kg"
    },
    {
      "name": "c",
      "value": 0.5,
      "description": "Damping coefficient",
      "unit": "N·s/m"
    },
    {
      "name": "k",
      "value": 2.0,
      "description": "Spring stiffness",
      "unit": "N/m"
    },
    {
      "name": "Kp",
      "value": 40.0,
      "description": "Proportional gain",
      "unit": "N/m"
    },
    {
      "name": "Ki",
      "value": 30.0,
      "description": "Integral gain",
      "unit": "N/(m·s)"
    },
    {
      "name": "Kd",
      "value": 8.0,
      "description": "Derivative gain",
      "unit": "N·s/m"
    }
  ],
  "blocks": [
    {
      "name": "reference",
      "type": "sources.step",
      "params": {
        "time": 0.5,
        "initial": 0.0,
        "final": 1.0,
        "sample_time": 0.0
      },
      "meta": {
        "position": [
          0,
          0.0
        ]
      }
    },
    {
      "name": "error",
      "type": "math.sum",
      "params": {
        "signs": "+-",
        "output_type": "inherit"
      },
      "meta": {
        "position": [
          160,
          0.0
        ]
      }
    },
    {
      "name": "pid",
      "type": "control.pid",
      "params": {
        "P": "Kp",
        "I": "Ki",
        "D": "Kd",
        "N": 100.0,
        "initial_integrator": 0.0,
        "upper": 50.0,
        "lower": -50.0,
        "anti_windup": "clamping",
        "Kb": 1.0
      },
      "meta": {
        "position": [
          320,
          0.0
        ]
      }
    },
    {
      "name": "forces",
      "type": "math.sum",
      "params": {
        "signs": "+--",
        "output_type": "inherit"
      },
      "meta": {
        "position": [
          480,
          0.0
        ]
      }
    },
    {
      "name": "1/m",
      "type": "math.gain",
      "params": {
        "gain": "1 / m",
        "multiplication": "elementwise",
        "output_type": "inherit"
      },
      "meta": {
        "position": [
          640,
          0.0
        ]
      }
    },
    {
      "name": "velocity",
      "type": "continuous.integrator",
      "params": {
        "initial": 0.0,
        "upper": "inf",
        "lower": "-inf",
        "external_reset": "none",
        "initial_source": "internal",
        "saturation_port": false
      },
      "meta": {
        "position": [
          800,
          0.0
        ]
      }
    },
    {
      "name": "position",
      "type": "continuous.integrator",
      "params": {
        "initial": 0.0,
        "upper": "inf",
        "lower": "-inf",
        "external_reset": "none",
        "initial_source": "internal",
        "saturation_port": false
      },
      "meta": {
        "position": [
          960,
          0.0
        ]
      }
    },
    {
      "name": "c",
      "type": "math.gain",
      "params": {
        "gain": "c",
        "multiplication": "elementwise",
        "output_type": "inherit"
      },
      "meta": {
        "position": [
          960,
          110.0
        ]
      }
    },
    {
      "name": "k",
      "type": "math.gain",
      "params": {
        "gain": "k",
        "multiplication": "elementwise",
        "output_type": "inherit"
      },
      "meta": {
        "position": [
          1120,
          0.0
        ]
      }
    },
    {
      "name": "scope",
      "type": "sinks.scope",
      "params": {
        "num_inputs": 3
      },
      "meta": {
        "position": [
          1120,
          110.0
        ]
      }
    }
  ],
  "connections": [
    {
      "src": "reference",
      "src_port": 0,
      "dst": "error",
      "dst_port": 0
    },
    {
      "src": "position",
      "src_port": 0,
      "dst": "error",
      "dst_port": 1
    },
    {
      "src": "error",
      "src_port": 0,
      "dst": "pid",
      "dst_port": 0
    },
    {
      "src": "pid",
      "src_port": 0,
      "dst": "forces",
      "dst_port": 0
    },
    {
      "src": "c",
      "src_port": 0,
      "dst": "forces",
      "dst_port": 1
    },
    {
      "src": "k",
      "src_port": 0,
      "dst": "forces",
      "dst_port": 2
    },
    {
      "src": "forces",
      "src_port": 0,
      "dst": "1/m",
      "dst_port": 0
    },
    {
      "src": "1/m",
      "src_port": 0,
      "dst": "velocity",
      "dst_port": 0
    },
    {
      "src": "velocity",
      "src_port": 0,
      "dst": "position",
      "dst_port": 0
    },
    {
      "src": "velocity",
      "src_port": 0,
      "dst": "c",
      "dst_port": 0
    },
    {
      "src": "position",
      "src_port": 0,
      "dst": "k",
      "dst_port": 0
    },
    {
      "src": "reference",
      "src_port": 0,
      "dst": "scope",
      "dst_port": 0
    },
    {
      "src": "position",
      "src_port": 0,
      "dst": "scope",
      "dst_port": 1
    },
    {
      "src": "pid",
      "src_port": 0,
      "dst": "scope",
      "dst_port": 2
    }
  ],
  "tests": [
    {
      "name": "PID reaches the reference",
      "description": "Within 2 % of the 1 m reference after 6 s, overshoot below 15 %, force within the ±50 N limit",
      "stop_time": 10.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "position",
          "lower": 0.98,
          "upper": 1.02,
          "t_from": 6.0
        },
        {
          "kind": "bounds",
          "signal": "position",
          "upper": 1.15
        },
        {
          "kind": "bounds",
          "signal": "pid",
          "lower": -50.0,
          "upper": 50.0
        }
      ]
    }
  ]
}
