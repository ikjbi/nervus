              "port": 1,
              "value": 0.0,
              "sample_time": -1.0,
              "output_type": "double"
            }
          },
          {
            "name": "o2_volts",
            "type": "ports.inport",
            "params": {
              "port": 2,
              "value": 0.0,
              "sample_time": -1.0,
              "output_type": "double"
            }
          },
          {
            "name": "base_fuel",
            "type": "math.gain",
            "params": {
              "gain": 0.06802721088435375,
              "multiplication": "elementwise",
              "output_type": "inherit"
            }
          },
          {
            "name": "rich",
            "type": "logic.compare_to_constant",
            "params": {
              "operator": ">",
              "constant": 0.45
            }
          },
          {
            "name": "minus_2_rich",
            "type": "math.gain",
            "params": {
              "gain": -2.0,
              "multiplication": "elementwise",
              "output_type": "inherit"
            }
          },
          {
            "name": "direction",
            "type": "math.sum",
            "params": {
              "signs": "++",
              "output_type": "inherit"
            }
          },
          {
            "name": "stft_ramp_part",
            "type": "discrete.integrator",
            "params": {
              "gain": "stft_ramp",
              "initial": 0.0,
              "method": "forward_euler",
              "upper": 25.0,
              "lower": -25.0,
              "external_reset": "none",
              "sample_time": 0.01
            }
          },
          {
            "name": "stft_jump_part",
            "type": "math.gain",
            "params": {
              "gain": "stft_jump",
              "multiplication": "elementwise",
              "output_type": "inherit"
            }
          },
          {
            "name": "stft_pct",
            "type": "math.sum",
            "params": {
              "signs": "++",
              "output_type": "inherit"
            }
          },
          {
            "name": "ltft_pct",
            "type": "lookup.adaptive_map",
            "params": {
              "row_breakpoints": [
                4.0,
                10.0,
                25.0
              ],
              "column_breakpoints": [
                0.0,
                1.0
              ],
              "initial": 0.0,
              "rate": "ltft_rate",
              "limit": 25.0,
              "sample_time": 0.01
            }
          },
          {
            "name": "trim_pct",
            "type": "math.sum",
            "params": {
              "signs": "+++",
              "output_type": "inherit"
            }
          },
          {
            "name": "trim_fraction",
            "type": "math.gain",
            "params": {
              "gain": 0.01,
              "multiplication": "elementwise",
              "output_type": "inherit"
            }
          },
          {
            "name": "cylinder_fuel",
            "type": "math.product",
            "params": {
              "ops": "**",
              "output_type": "inherit"
            }
          },
          {
            "name": "film_estimate",
            "type": "discrete.unit_delay",
            "params": {
              "initial": 0.0,
              "sample_time": 0.01
            }
          },
          {
            "name": "evaporation",
            "type": "math.gain",
            "params": {
              "gain": "xtau_comp / tau_film",
              "multiplication": "elementwise",
              "output_type": "inherit"
            }
          },
          {
            "name": "minus_evaporation",
            "type": "math.sum",
            "params": {
              "signs": "+-",
              "output_type": "inherit"
            }
          },
          {
            "name": "injection",
            "type": "math.gain",
            "params": {
              "gain": "1 / (1 - xtau_comp * X_film)",
              "multiplication": "elementwise",
              "output_type": "inherit"
            }
          },
          {
            "name": "to_film",
            "type": "math.gain",
            "params": {
              "gain": "X_film * 0.01",
              "multiplication": "elementwise",
              "output_type": "inherit"
            }
          },
          {
            "name": "from_film",
            "type": "math.gain",
            "params": {
              "gain": "0.01 / tau_film",
              "multiplication": "elementwise",
              "output_type": "inherit"
            }
          },
          {
            "name": "film_update",
            "type": "math.sum",
            "params": {
              "signs": "++-",
              "output_type": "inherit"
            }
          },
          {
            "name": "one",
            "type": "sources.constant",
            "params": {
              "value": 1.0,
              "sample_time": "inf",
              "output_type": "double"
            }
          },
          {
            "name": "learn",
            "type": "sources.constant",
            "params": {
              "value": 1.0,
              "sample_time": "inf",
              "output_type": "double"
            }
          },
          {
            "name": "y_cell",
            "type": "sources.constant",
            "params": {
              "value": 0.0,
              "sample_time": "inf",
              "output_type": "double"
            }
          },
          {
            "name": "hundred",
            "type": "sources.constant",
            "params": {
              "value": 100.0,
              "sample_time": "inf",
              "output_type": "double"
            }
          },
          {
