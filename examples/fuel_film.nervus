          0.0
        ]
      }
    },
    {
      "name": "lambda_cyl",
      "type": "user.python_function",
      "params": {
        "code": "def f(t, air, fuel):\n    \"\"\"Lambda of the mixture in the cylinder (1 = stoichiometric, AFR 14.7).\"\"\"\n    return air / (14.7 * max(fuel, 1e-6))\n",
        "num_inputs": 2,
        "num_outputs": 1,
        "output_width": -1,
        "parameters": []
      },
      "meta": {
        "position": [
          1280.0,
          0.0
        ]
      }
    },
    {
      "name": "sensor_lag",
      "type": "continuous.transfer_function",
      "params": {
        "numerator": [
          1.0
        ],
        "denominator": [
          0.05,
          1.0
        ]
      },
      "meta": {
        "position": [
          1280.0,
          120.0
        ]
      }
    },
    {
      "name": "o2_sensor",
      "type": "user.python_function",
      "params": {
        "code": "def f(t, lam):\n    \"\"\"A narrow-band (zirconia) sensor: about 0.8 V rich, 0.1 V lean, switching steeply at lambda = 1.\"\"\"\n    return 0.45 + 0.37 * math.tanh((1.0 - lam) * 60.0)\n",
        "num_inputs": 1,
        "num_outputs": 1,
        "output_width": -1,
        "parameters": []
      },
      "meta": {
        "position": [
          1160.0,
          200.0
        ],
        "flipped": true
      }
    },
