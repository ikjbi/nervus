{
  "format": "nervus-model",
  "schema_version": 4,
  "name": "fuel_film",
  "meta": {},
  "settings": {
    "t_start": 0.0,
    "t_final": 40.0,
    "solver": "rk4",
    "step": 0.005,
    "max_step": null,
    "rtol": 1e-06,
    "atol": 1e-08,
    "zero_crossing": true
  },
  "workspace": [
    {
      "name": "X_film",
      "value": 0.3,
      "description": "Share of the injected fuel that lands on the wall",
      "unit": "-"
    },
    {
      "name": "tau_film",
      "value": 0.3,
      "description": "Evaporation time constant of the wall film",
      "unit": "s"
    },
    {
      "name": "xtau_comp",
      "value": 1.0,
      "description": "1: the ECU compensates the wall film, 0: off",
      "unit": "-"
    },
    {
      "name": "stft_jump",
      "value": 2.0,
      "description": "Short-term trim jump when the sensor switches",
      "unit": "%"
    },
    {
      "name": "stft_ramp",
      "value": 8.0,
      "description": "Short-term trim ramp between switches",
      "unit": "%/s"
    },
    {
      "name": "ltft_rate",
      "value": 0.6,
      "description": "Learning rate of the long-term trim",
      "unit": "1/s"
    }
  ],
