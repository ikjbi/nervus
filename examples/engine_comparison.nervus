          }
        ],
        "icon": "Throttle\\nactuator",
        "description": "Electronic throttle as a first-order lag"
      },
      "link": {
        "library": "library/engine_parts.nervlib",
        "component": "throttle_actuator"
      }
    },
    {
      "name": "engine_1_6l",
      "type": "ports.subsystem",
      "params": {
        "enable_port": false,
        "when_enabled": "held",
        "trigger": "none"
      },
      "meta": {
        "position": [
          640.0,
          0.0
        ]
      },
      "system": {
        "blocks": [
          {
            "name": "throttle_deg",
            "type": "ports.inport",
            "params": {
              "port": 1,
              "value": 0.0,
              "sample_time": -1.0,
              "output_type": "double"
            },
            "meta": {
              "position": [
                0.0,
                0.0
              ]
            }
          },
          {
            "name": "load_torque",
            "type": "ports.inport",
            "params": {
              "port": 2,
              "value": 0.0,
              "sample_time": -1.0,
              "output_type": "double"
            },
            "meta": {
              "position": [
                0.0,
                300.0
              ]
            }
          },
          {
            "name": "throttle_flow",
            "type": "user.python_function",
            "params": {
              "code": "def f(t, alpha_deg, p_im):\n    \"\"\"Air mass flow through the throttle [kg/s]. p = [max throttle area m^2]\"\"\"\n    p_amb, T, R, gamma, cd = 101325.0, 293.0, 287.0, 1.4, 0.8\n    area = p[0] * (1 - math.cos(math.radians(max(alpha_deg, 0.0)))) + 4e-6\n    pr = min(max(p_im / p_amb, 0.0), 1.0)\n    if pr < 0.528:  # choked flow\n        psi = 0.6847\n    else:\n        psi = math.sqrt(2 * gamma / (gamma - 1) * (pr ** (2 / gamma) - pr ** ((gamma + 1) / gamma)))\n    return cd * area * p_amb / math.sqrt(R * T) * psi\n",
              "num_inputs": 2,
              "num_outputs": 1,
              "output_width": -1,
              "parameters": "[throttle_area]"
            },
            "meta": {
              "position": [
                150.0,
                0.0
              ]
            }
          },
          {
            "name": "cylinder_flow",
            "type": "user.python_function",
            "params": {
              "code": "def f(t, p_im, omega):\n    \"\"\"Air mass flow into the cylinders [kg/s]. p = [eta_vol, displacement m^3]\"\"\"\n    R, T = 287.0, 293.0\n    return p[0] * p_im * p[1] * max(omega, 0.0) / (4 * math.pi * R * T)\n",
              "num_inputs": 2,
              "num_outputs": 1,
              "output_width": -1,
              "parameters": "[eta_vol, displacement]"
            },
            "meta": {
              "position": [
                450.0,
                150.0
              ]
            }
          },
          {
            "name": "manifold_net_flow",
            "type": "math.sum",
            "params": {
              "signs": "+-",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                300.0,
                0.0
              ]
            }
          },
          {
            "name": "R_T_over_V",
            "type": "math.gain",
            "params": {
              "gain": "287 * 293 / V_im",
              "multiplication": "elementwise",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                450.0,
                0.0
              ]
            }
          },
          {
            "name": "p_intake",
            "type": "continuous.integrator",
            "params": {
              "initial": 30000.0,
              "upper": 101325.0,
              "lower": 1000.0
            },
            "meta": {
              "position": [
                600.0,
                0.0
              ]
            }
          },
          {
            "name": "net_torque",
            "type": "user.python_function",
            "params": {
              "code": "def f(t, m_cyl, omega, load):\n    \"\"\"Net crankshaft torque [N·m]. p = [eta_th, displacement m^3]\"\"\"\n    q_lhv, afr = 44e6, 14.7\n    omega = max(omega, 10.0)\n    combustion = p[0] * q_lhv * (m_cyl / afr) / omega\n    friction = (10.0 + 0.02 * omega) * p[1] / 1.6e-3  # friction grows with engine size\n    return combustion - friction - load\n",
              "num_inputs": 3,
              "num_outputs": 1,
              "output_width": -1,
              "parameters": "[eta_th, displacement]"
            },
            "meta": {
              "position": [
                600.0,
                300.0
              ]
            }
          },
          {
            "name": "1/J",
            "type": "math.gain",
            "params": {
              "gain": "1 / J",
              "multiplication": "elementwise",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                750.0,
                300.0
              ]
            }
          },
          {
            "name": "omega",
            "type": "continuous.integrator",
            "params": {
              "initial": 83.7758040957278,
              "upper": "inf",
              "lower": 0.0
            },
            "meta": {
              "position": [
                900.0,
                300.0
              ]
            }
          },
          {
            "name": "to_rpm",
            "type": "math.gain",
            "params": {
              "gain": 9.549296585513721,
              "multiplication": "elementwise",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                1050.0,
                300.0
              ]
            }
          },
          {
            "name": "rpm",
            "type": "ports.outport",
            "params": {
              "port": 1
            },
            "meta": {
              "position": [
                1200.0,
                300.0
              ]
            }
          },
          {
            "name": "p_im",
            "type": "ports.outport",
            "params": {
              "port": 2
            },
            "meta": {
              "position": [
                900.0,
                0.0
              ]
            }
          }
        ],
