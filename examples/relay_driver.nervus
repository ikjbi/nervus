  "tests": [
    {
      "name": "collector clamped by the freewheeling diode",
      "description": "When the transistor switches off, the coil's current flows through the diode: V(col) stays below 13 V",
      "stop_time": 0.02,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "collector",
          "lower": -0.5,
          "upper": 13.0
        },
        {
          "kind": "bounds",
          "signal": "collector",
