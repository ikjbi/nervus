      "b_port": "p"
    },
    {
      "a": "S1",
      "a_port": "n",
      "b": "D1",
      "b_port": "n"
    },
    {
      "a": "S1",
      "a_port": "n",
      "b": "L1",
      "b_port": "p"
    },
    {
      "a": "L1",
      "a_port": "n",
      "b": "C1",
      "b_port": "p"
    },
    {
      "a": "gnd",
      "a_port": "p",
      "b": "C1",
      "b_port": "n"
    },
    {
      "a": "L1",
      "a_port": "n",
