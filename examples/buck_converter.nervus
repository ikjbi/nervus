    },
    {
      "a": "L1",
      "a_port": "n",
      "b": "V(out)",
      "b_port": "p"
    },
    {
      "a": "gnd",
      "a_port": "p",
      "b": "V(out)",
      "b_port": "n"
    }
  ],
  "tests": [
    {
      "name": "about 5 V out",
      "description": "Duty cycle 42 % of 12 V, minus the losses: the output settles near 5 V",
      "stop_time": 0.005,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "vout",
          "lower": 4.3,
          "upper": 5.3,
          "t_from": 0.003,
          "t_to": 0.005
        }
      ]
