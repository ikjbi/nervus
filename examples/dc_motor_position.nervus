{
  "format": "nervus-model",
  "schema_version": 4,
  "name": "dc_motor_position",
  "meta": {},
  "settings": {
    "t_start": 0.0,
    "t_final": 0.6,
    "solver": "auto",
    "step": null,
    "max_step": 0.0002,
    "rtol": 1e-06,
    "atol": 1e-08,
    "zero_crossing": true
  },
  "workspace": [
    {
      "name": "R_m",
      "value": 8.4,
      "description": "Armature resistance",
      "unit": "Ω"
    },
    {
      "name": "L_m",
      "value": 0.00116,
      "description": "Armature inductance",
      "unit": "H"
    },
    {
      "name": "k_m",
      "value": 0.042,
      "description": "Torque constant (= back-EMF constant in V·s/rad)",
      "unit": "N·m/A"
    },
    {
      "name": "J",
      "value": 2.1e-05,
      "description": "Rotor and inertia disk",
      "unit": "kg·m²"
    },
    {
      "name": "b",
      "value": 1e-07,
      "description": "Viscous friction",
      "unit": "N·m·s/rad"
    },
    {
      "name": "V_max",
      "value": 10.0,
      "description": "Amplifier limit",
      "unit": "V"
    },
    {
      "name": "Kp_th",
      "value": 6.5,
      "description": "Position controller: proportional gain (ωn = 40 rad/s)",
      "unit": "V/rad"
    },
    {
      "name": "Kd_th",
      "value": 0.186,
      "description": "Position controller: derivative gain (ζ = 0.7)",
      "unit": "V·s/rad"
    }
  ],
  "blocks": [
    {
      "name": "gnd",
