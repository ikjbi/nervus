      "meta": {
        "position": [
          710.0,
          0.0
        ]
      }
    },
    {
      "name": "friction",
      "type": "rotational.damper",
      "params": {
        "d": "b"
      },
      "meta": {
        "position": [
          710.0,
          100.0
        ]
      }
    },
    {
      "name": "frame",
