  "tests": [
    {
      "name": "full-throttle launch shifts late",
      "description": "With the pedal at 100 % the engine revs high before each upshift: 1 -> 2 at 40 km/h, 2 -> 3 at 70",
      "stop_time": 9.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "gear",
          "lower": 1.0,
          "upper": 1.0,
          "t_from": 0.0,
          "t_to": 3.4
        },
        {
          "kind": "bounds",
          "signal": "speed",
          "lower": 38.0,
          "upper": 200.0,
          "t_from": 3.5,
          "t_to": 9.0
        },
        {
          "kind": "bounds",
          "signal": "rpm",
          "lower": 800.0,
          "upper": 6000.0
        },
        {
          "kind": "final_value",
          "signal": "gear",
          "value": 3.0
        }
      ]
    },
    {
      "name": "light pedal cruises in top gear",
      "description": "At 20 % pedal the thresholds are low: the gearbox shifts up to 5th and the engine speed drops",
      "stop_time": 20.0,
      "inputs": {},
      "checks": [
        {
          "kind": "final_value",
          "signal": "gear",
          "value": 5.0
        },
        {
          "kind": "bounds",
          "signal": "rpm",
          "lower": 1500.0,
          "upper": 2500.0,
          "t_from": 12.0,
          "t_to": 20.0
        }
      ]
    },
    {
      "name": "kickdown",
      "description": "Pressing the pedal fully at cruising speed drops two gears (one per second) for acceleration",
      "stop_time": 25.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "gear",
          "lower": 4.0,
          "upper": 4.0,
          "t_from": 22.2,
          "t_to": 23.0
        },
        {
          "kind": "bounds",
          "signal": "gear",
          "lower": 3.0,
          "upper": 3.0,
          "t_from": 23.2,
          "t_to": 25.0
        }
      ]
    },
    {
      "name": "downshift on a hill",
      "description": "A 10 % hill at a steady 60 % pedal: the car slows and the gearbox drops to 4th",
      "stop_time": 45.0,
      "inputs": {},
      "checks": [
