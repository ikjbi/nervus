                {
                  "name": "road_loads",
                  "type": "user.python_function",
                  "params": {
                    "code": "def f(t, v, grade):\n    \"\"\"Road loads [N] at speed v [m/s] on a grade [%]. p = [m kg, c_d*A m2, c_rr]\"\"\"\n    m, cda, crr = p[0], p[1], p[2]\n    slope = np.arctan(grade / 100.0)\n    roll = m * 9.81 * crr * np.cos(slope) * min(1.0, v / 0.1)  # no rolling resistance at standstill\n    return 0.5 * 1.2 * cda * v * v + roll + m * 9.81 * np.sin(slope)\n",
                    "num_inputs": 2,
                    "num_outputs": 1,
                    "output_width": -1,
                    "parameters": "[mass, cd_area, c_rr]"
                  },
                  "meta": {
                    "position": [
                      250.0,
                      170.0
                    ]
