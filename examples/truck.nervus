        "position": [
          640.0,
          220.0
        ]
      }
    },
    {
      "name": "cruise_control",
      "type": "control.discrete_pid",
      "params": {
        "P": 0.15,
        "I": 0.02,
        "D": 0.0,
        "N": 100.0,
        "initial_integrator": 0.0,
        "upper": 1.0,
        "lower": 0.0,
        "anti_windup": "clamping",
        "Kb": 1.0,
        "sample_time": 0.05
      },
