  "tests": [
    {
      "name": "the climb: AMT keeps the engine in its torque band",
      "description": "On the 6 % climb the truck slows; the gearbox downshifts and the engine stays between 1000 and 1700 rpm",
      "stop_time": 110.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "rpm",
          "lower": 950.0,
          "upper": 1750.0,
          "t_from": 40.0,
          "t_to": 110.0
        }
      ]
    },
    {
      "name": "the descent: the exhaust brake limits the speed",
      "description": "On the 6 % descent the exhaust brake (with the engine high in 11th gear) holds the truck below 100 km/h",
      "stop_time": 420.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "speed",
          "lower": 30.0,
          "upper": 100.0,
          "t_from": 190.0,
          "t_to": 420.0
        }
      ]
    }
  ]
