        "sample_time": "inf",
        "output_type": "double"
      },
      "meta": {
        "position": [
          0.0,
          330.0
        ]
      }
    },
    {
      "name": "exhaust_brake_request",
      "type": "user.python_function",
      "params": {
        "code": "def f(t, v, vset, fitted):\n    return 1.0 if fitted > 0.5 and v > vset + p[0] else 0.0\n",
        "num_inputs": 3,
        "num_outputs": 1,
        "output_width": -1,
        "parameters": "[brake_margin]"
      },
      "meta": {
        "position": [
          160.0,
          330.0
        ]
      }
    },
    {
      "name": "brake_fitted",
      "type": "sources.constant",
      "params": {
        "value": "exhaust_brake",
        "sample_time": "inf",
        "output_type": "double"
      },
      "meta": {
        "position": [
          320.0,
          330.0
        ]
      }
    },
    {
      "name": "amt_tcu",
      "type": "charts.state_chart",
      "params": {
        "definition": "\ninput rpm, brake_request\noutput gear = 12, shifting = 0\nlocal target = 12\nparam up_rpm, down_rpm, hold_rpm, shift_time, n_gears\n\nstate driving\n  entry: shifting = 0\nstate shifting_up\n  entry: shifting = 1; target = gear + 1\nstate shifting_down\n  entry: shifting = 1; target = gear - 1\n\ntransition driving -> shifting_down: rpm < down_rpm and gear > 1 and after(10)\ntransition driving -> shifting_down: brake_request > 0.5 and rpm < hold_rpm and gear > 1 and after(10)\ntransition driving -> shifting_up: rpm > up_rpm and gear < n_gears and brake_request < 0.5 and after(10)\ntransition shifting_up -> driving: t_in_state >= shift_time / gear = target\ntransition shifting_down -> driving: t_in_state >= shift_time / gear = target\n",
        "state_output": true,
        "sample_time": 0.05
      },
      "meta": {
        "position": [
          480.0,
          330.0
        ]
      }
    },
    {
      "name": "scope",
      "type": "sinks.scope",
      "params": {
        "num_inputs": 3
      },
      "meta": {
        "position": [
          640.0,
          330.0
        ]
      }
    },
