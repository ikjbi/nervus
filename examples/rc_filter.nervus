{
  "format": "nervus-model",
  "schema_version": 4,
  "name": "rc_filter",
  "meta": {},
  "settings": {
    "t_start": 0.0,
    "t_final": 0.008,
    "solver": "auto",
    "step": null,
    "max_step": 1.6e-05,
    "rtol": 1e-06,
    "atol": 1e-08,
    "zero_crossing": true
  },
  "workspace": [
    {
      "name": "R",
      "value": 1000.0,
      "description": "Resistor",
      "unit": "Ω"
    },
    {
      "name": "C",
      "value": 1e-06,
      "description": "Capacitor",
      "unit": "F"
    }
  ],
  "blocks": [
    {
      "name": "v_in",
      "type": "ports.inport",
      "params": {
        "port": 1,
        "value": 5.0,
        "sample_time": -1.0,
        "output_type": "double"
      },
      "meta": {
        "position": [
          0.0,
          0.0
        ]
      }
    },
    {
      "name": "source",
      "type": "electrical.voltage_source",
      "params": {
        "V": 12.0,
        "controlled": true
      },
      "meta": {
        "position": [
          140.0,
          0.0
        ]
      }
    },
    {
      "name": "gnd",
      "type": "electrical.reference",
      "params": {},
      "meta": {
        "position": [
          280.0,
          0.0
        ]
      }
    },
    {
      "name": "R",
      "type": "electrical.resistor",
      "params": {
        "R": "R"
      },
      "meta": {
        "position": [
          420.0,
          0.0
        ]
      }
    },
    {
      "name": "C",
      "type": "electrical.capacitor",
      "params": {
        "C": "C",
        "v0": 0.0
      },
      "meta": {
        "position": [
          560.0,
          0.0
        ]
      }
    },
    {
      "name": "v_cap_sensor",
      "type": "electrical.voltage_sensor",
      "params": {},
      "meta": {
        "position": [
          0.0,
          110.0
        ]
      }
    },
    {
      "name": "v_out",
      "type": "ports.outport",
      "params": {
        "port": 1
      },
      "meta": {
        "position": [
          140.0,
          110.0
        ]
      }
    },
    {
      "name": "scope",
      "type": "sinks.scope",
      "params": {
        "num_inputs": 2
      },
      "meta": {
        "position": [
          280.0,
          110.0
        ]
      }
    }
  ],
  "connections": [
    {
      "src": "v_in",
      "src_port": 0,
      "dst": "source",
      "dst_port": 0
    },
    {
      "src": "v_cap_sensor",
      "src_port": 0,
      "dst": "v_out",
      "dst_port": 0
    },
    {
      "src": "v_in",
      "src_port": 0,
      "dst": "scope",
      "dst_port": 0
    },
    {
      "src": "v_cap_sensor",
      "src_port": 0,
      "dst": "scope",
      "dst_port": 1
    }
  ],
  "links": [
    {
      "a": "source",
      "a_port": "n",
      "b": "gnd",
      "b_port": "p"
    },
    {
      "a": "source",
      "a_port": "p",
      "b": "R",
      "b_port": "p"
    },
    {
      "a": "R",
      "a_port": "n",
      "b": "C",
      "b_port": "p"
    },
    {
      "a": "C",
      "a_port": "n",
      "b": "gnd",
      "b_port": "p"
    },
    {
      "a": "v_cap_sensor",
      "a_port": "p",
      "b": "C",
      "b_port": "p"
    },
    {
      "a": "v_cap_sensor",
      "a_port": "n",
      "b": "gnd",
      "b_port": "p"
    }
  ],
  "tests": [
    {
      "name": "time constant",
      "description": "After one time constant (RC = 1 ms) the capacitor is at 63 % of 5 V; after 5 RC at 99 %",
      "stop_time": 0.008,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "v_out",
          "lower": 3.14,
          "upper": 3.18,
          "t_from": 0.001,
          "t_to": 0.00101
        },
        {
          "kind": "bounds",
          "signal": "v_out",
          "lower": 4.96,
          "t_from": 0.005
        }
      ]
    }
  ]
}
