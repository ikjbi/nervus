  "tests": [
    {
      "name": "accurate from -10 to 95 °C",
      "description": "The ECU reads the coolant temperature within 0.5 °C over the warm-up (after the filter settles)",
      "stop_time": 300.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "ecu_temp",
          "lower": -11.0,
          "upper": 96.0,
          "t_from": 0.2
        },
        {
          "kind": "bounds",
          "signal": "P0118_pending",
          "upper": 0.0
        },
        {
          "kind": "bounds",
          "signal": "P0117_pending",
          "upper": 0.0
        }
      ]
    },
    {
      "name": "open circuit: P0118 and the substitute value",
      "description": "The harness breaks at 200 s: within 0.7 s the code is pending and the ECU uses 80 °C",
      "stop_time": 210.0,
      "parameters": {
        "fault": 1.0
      },
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "P0118_pending",
          "lower": 1.0,
          "t_from": 200.7
        },
        {
          "kind": "bounds",
          "signal": "ecu_temp",
          "lower": 80.0,
          "upper": 80.0,
          "t_from": 200.7
        }
      ]
    },
    {
      "name": "short to ground: P0117",
      "description": "The signal wire is shorted to ground at 200 s: P0117 within 0.7 s",
      "stop_time": 210.0,
      "parameters": {
        "fault": 2.0
      },
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "P0117_pending",
          "lower": 1.0,
          "t_from": 200.7
        }
      ]
    }
  ]
}
