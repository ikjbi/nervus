    {
      "name": "fault_injection",
      "type": "user.python_function",
      "params": {
        "code": "def f(t, temp):\n    \"\"\"Harness resistance [Ω] and resistance of the signal wire to ground [Ω] (fault injection).\"\"\"\n    fault, at = p[0], p[1]\n    broken = t >= at\n    open_ = 1e8 if (fault == 1 and broken) else 0.5\n    short = 0.05 if (fault == 2 and broken) else 1e9\n    return [open_, short]\n",
        "num_inputs": 1,
        "num_outputs": 1,
        "output_width": 2,
        "parameters": "[fault, fault_time]"
      },
      "meta": {
        "position": [
          0.0,
          300.0
        ]
      }
    },
