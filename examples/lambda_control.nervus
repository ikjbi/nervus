  "tests": [
    {
      "name": "vacuum leak learned by the LTFT",
      "description": "6 % unmetered air at 12 s: after 25 s the LTFT has learned it and the STFT is back near 0",
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "lambda_cyl",
          "lower": 0.97,
          "upper": 1.03,
          "t_from": 15.0
        },
        {
          "kind": "final_value",
          "signal": "ECU/ltft_pct",
          "value": 6.0,
          "tolerance": 0.6
        },
        {
          "kind": "final_value",
          "signal": "ECU/stft_pct",
          "value": 0.0,
          "tolerance": 1.0
        }
      ]
    },
    {
      "name": "clogged injector",
      "description": "Injectors deliver 5 % less fuel: the LTFT learns about +5 %",
      "parameters": {
        "leak": 0.0,
        "injector_error": -0.05
      },
      "inputs": {},
      "checks": [
        {
          "kind": "final_value",
          "signal": "ECU/ltft_pct",
          "value": 5.3,
          "tolerance": 0.6
        }
      ]
    },
    {
      "name": "tip-in and tip-out stay close to lambda 1",
      "description": "The air charge changes by 60 %; the base fuel follows the measured air, so lambda stays at 1 (this simple plant has no fuel film on the intake walls, which causes lean spikes in real engines)",
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "lambda_cyl",
          "lower": 0.99,
          "upper": 1.01,
          "t_to": 11.9
        }
      ]
    }
  ]
}
