{
  "format": "nervus-model",
  "schema_version": 4,
  "name": "lambda_control",
  "meta": {},
  "settings": {
    "t_start": 0.0,
    "t_final": 40.0,
    "solver": "rk4",
    "step": 0.005,
    "max_step": null,
    "rtol": 1e-06,
    "atol": 1e-08,
    "zero_crossing": true
  },
  "workspace": [
    {
      "name": "Ts",
      "value": 0.01,
      "description": "Fuel task period",
      "unit": "s"
    },
    {
      "name": "Kp_stft",
      "value": 0.1,
      "description": "STFT proportional gain",
      "unit": "1/λ"
    },
    {
      "name": "Ki_stft",
      "value": 1.0,
      "description": "STFT integral gain",
      "unit": "1/(λ·s)"
    },
    {
      "name": "K_ltft",
      "value": 0.1,
      "description": "LTFT learning rate",
      "unit": "1/s"
    },
    {
      "name": "q_inj",
      "value": 4.0,
      "description": "Injector flow (nominal)",
      "unit": "mg/ms"
    },
    {
      "name": "t_dead",
      "value": 0.4,
      "description": "Injector dead time",
      "unit": "ms"
    },
    {
      "name": "injector_error",
      "value": 0.0,
      "description": "Actual injector flow error (e.g. -0.05 = clogged)",
      "unit": "-"
    },
    {
      "name": "leak",
      "value": 0.06,
      "description": "Unmetered air from t = 12 s (vacuum leak)",
      "unit": "-"
    },
    {
      "name": "n_exh",
      "value": 8.0,
      "description": "Exhaust transport delay to the sensor",
      "unit": "samples of 10 ms"
    },
    {
      "name": "tau_sensor",
      "value": 0.1,
      "description": "Lambda sensor time constant",
      "unit": "s"
    }
  ],
  "blocks": [
