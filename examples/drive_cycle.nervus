            "meta": {
              "position": [
                0.0,
                0.0
              ]
            }
          },
          {
            "name": "wheel_force",
            "type": "user.python_function",
            "params": {
              "code": "def f(t, pedal, v):\n    \"\"\"Wheel force [N] from the pedal (-1 brake .. +1 throttle). p = [F_max N, P_max W, F_brake_max N]\"\"\"\n    if pedal >= 0:\n        return pedal * min(p[0], p[1] / max(v, 0.5))  # traction: force limit, then power limit\n    return pedal * p[2] * min(1.0, v / 0.2)  # brakes (fade out at standstill so the car does not roll back)\n",
              "num_inputs": 2,
              "num_outputs": 1,
              "output_width": -1,
              "parameters": "[F_max, P_max, F_brake_max]"
            },
            "meta": {
              "position": [
                150.0,
                0.0
              ]
            }
          },
          {
            "name": "net_force",
            "type": "math.sum",
            "params": {
              "signs": "+--",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                300.0,
                0.0
              ]
            }
          },
          {
            "name": "1/m",
            "type": "math.gain",
            "params": {
              "gain": "1 / m",
              "multiplication": "elementwise",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                450.0,
                0.0
              ]
            }
          },
          {
            "name": "speed",
            "type": "continuous.integrator",
            "params": {
              "initial": 0.0,
              "upper": "inf",
              "lower": 0.0
            },
            "meta": {
              "position": [
                600.0,
                0.0
              ]
            }
          },
          {
            "name": "v_squared",
            "type": "math.product",
            "params": {
              "ops": "**",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                300.0,
                150.0
              ]
            }
          },
          {
            "name": "F_aero",
            "type": "math.gain",
            "params": {
              "gain": "0.5 * 1.2 * cd_A",
              "multiplication": "elementwise",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                450.0,
                150.0
              ]
            }
          },
          {
