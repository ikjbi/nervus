    }
  ],
  "tests": [
    {
      "name": "AC compressor on at 5 s",
      "description": "With feed-forward the speed dips less than 50 rpm, and is back within ±20 rpm after 4 s",
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "engine_rpm",
          "lower": 780.0,
          "upper": 820.0,
          "t_from": 3.0,
          "t_to": 4.8
        },
        {
          "kind": "min",
          "signal": "engine_rpm",
          "value": 750.0
        },
        {
          "kind": "bounds",
          "signal": "engine_rpm",
          "lower": 780.0,
          "upper": 820.0,
          "t_from": 9.0
        }
      ]
    },
    {
      "name": "AC compressor on, no feed-forward",
      "description": "Feedback alone: a much deeper dip (but the engine must not stall)",
      "parameters": {
        "alpha_ac": 0.0
      },
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "engine_rpm",
          "lower": 600.0,
          "upper": 900.0,
          "t_from": 4.5
        }
      ]
    },
    {
      "name": "higher idle target",
      "parameters": {
        "rpm_idle": 1000.0
      },
      "inputs": {},
      "checks": [
        {
          "kind": "final_value",
          "signal": "engine_rpm",
          "value": 1000.0,
          "tolerance": 15.0
        }
      ]
    }
  ]
