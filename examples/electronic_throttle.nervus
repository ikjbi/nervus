  "tests": [
    {
      "name": "step to 60°",
      "description": "Full duty during the jump: 90 % in 50 ms, under 8° overshoot, within 1° after 150 ms",
      "stop_time": 0.3,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "throttle_deg",
          "lower": 54.0,
          "upper": 68.0,
          "t_from": 0.1,
          "t_to": 0.3
        },
        {
          "kind": "bounds",
          "signal": "throttle_deg",
          "lower": 59.0,
          "upper": 61.0,
          "t_from": 0.2,
          "t_to": 0.3
        },
        {
          "kind": "bounds",
          "signal": "throttle_deg",
          "lower": -0.5,
          "upper": 68.0
        }
      ]
    },
    {
      "name": "accurate at part throttle",
      "description": "At 20° the integral removes the steady error caused by friction and the spring",
      "stop_time": 0.6,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "throttle_deg",
          "lower": 19.5,
