      "meta": {
        "position": [
          330.0,
          140.0
        ]
      }
    },
    {
      "name": "h_bridge",
      "type": "electrical.h_bridge",
      "params": {},
      "meta": {
        "position": [
          480.0,
          140.0
        ]
      }
    },
    {
      "name": "motor",
      "type": "electrical.dc_motor",
      "params": {
        "R": "R_motor",
        "L": 0.0015,
        "k": "k_motor"
      },
      "meta": {
        "position": [
          640.0,
          150.0
        ]
      }
    },
    {
      "name": "rotor_and_plate",
      "type": "rotational.inertia",
      "params": {
        "J": 4.5e-06,
        "w0": 0.0
      },
      "meta": {
        "position": [
          800.0,
          80.0
        ]
      }
    },
    {
      "name": "gear",
      "type": "rotational.gear",
      "params": {
        "n": "n_gear"
      },
      "meta": {
        "position": [
          800.0,
          180.0
        ]
      }
    },
    {
      "name": "return_spring",
      "type": "rotational.spring",
      "params": {
        "k": "k_spring",
        "phi0": "spring_preload / k_spring"
      },
      "meta": {
        "position": [
          960.0,
          120.0
        ]
      }
    },
    {
      "name": "friction",
      "type": "rotational.damper",
      "params": {
        "d": 0.002
      },
      "meta": {
        "position": [
          960.0,
          220.0
        ]
      }
    },
    {
      "name": "housing",
      "type": "rotational.reference",
      "params": {},
      "meta": {
        "position": [
          1110.0,
          170.0
        ]
      }
    },
    {
