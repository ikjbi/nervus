{
  "format": "nervus-model",
  "schema_version": 4,
  "name": "electronic_throttle",
  "meta": {},
  "settings": {
    "t_start": 0.0,
    "t_final": 1.2,
    "solver": "auto",
    "step": null,
    "max_step": 0.0005,
    "rtol": 1e-06,
    "atol": 1e-08,
    "zero_crossing": true
  },
  "workspace": [
    {
      "name": "n_gear",
      "value": 20.0,
      "description": "Gear ratio motor : plate",
      "unit": "-"
    },
    {
      "name": "k_motor",
      "value": 0.02,
      "description": "Motor torque constant",
      "unit": "N·m/A"
    },
    {
      "name": "R_motor",
      "value": 1.5,
      "description": "Armature resistance",
      "unit": "Ω"
    },
    {
      "name": "k_spring",
      "value": 0.06,
      "description": "Return spring stiffness (at the plate)",
      "unit": "N·m/rad"
    },
    {
      "name": "spring_preload",
      "value": 0.05,
      "description": "Return spring torque at the closed position",
      "unit": "N·m"
    },
    {
      "name": "Kp_etc",
      "value": 0.08,
      "description": "Proportional gain: duty per degree of error",
      "unit": "1/°"
    },
    {
      "name": "Ki_etc",
      "value": 2.0,
      "description": "Integral gain",
      "unit": "1/(°·s)"
    },
    {
      "name": "Kd_etc",
      "value": 0.0008,
      "description": "Derivative gain",
      "unit": "s/°"
    }
  ],
  "blocks": [
    {
      "name": "pedal_target",
      "type": "sources.from_workspace",
      "params": {
        "time": [
          0.0,
          0.05,
          0.051,
          0.3,
          0.301,
          0.6,
          0.601,
          0.9,
          0.901,
          1.2
        ],
        "data": [
          [
            5.0
          ],
          [
            5.0
          ],
          [
            60.0
          ],
          [
            60.0
          ],
          [
            20.0
          ],
          [
            20.0
          ],
          [
            80.0
          ],
          [
            80.0
          ],
          [
            5.0
          ],
          [
            5.0
          ]
        ],
        "csv_file": "",
        "interpolation": "linear",
        "sample_time": 0.0
      },
      "meta": {
        "position": [
          0.0,
          0.0
        ]
      }
    },
    {
      "name": "ECU",
      "type": "ports.subsystem",
      "params": {
        "sample_time": 0.001,
        "enable_port": false,
        "when_enabled": "held",
        "trigger": "none"
      },
      "meta": {
        "position": [
          150.0,
          10.0
        ]
      },
      "system": {
        "blocks": [
          {
            "name": "target_deg",
            "type": "ports.inport",
            "params": {
              "port": 1,
              "value": 0.0,
              "sample_time": -1.0,
              "output_type": "double"
            },
            "meta": {
              "position": [
                0.0,
                0.0
              ]
            }
          },
          {
            "name": "tps_deg",
            "type": "ports.inport",
            "params": {
              "port": 2,
              "value": 0.0,
              "sample_time": -1.0,
              "output_type": "double"
            },
            "meta": {
              "position": [
                0.0,
                100.0
              ]
            }
          },
          {
            "name": "error",
            "type": "math.sum",
            "params": {
              "signs": "+-",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                130.0,
                40.0
              ]
            }
          },
          {
            "name": "pid",
            "type": "control.discrete_pid",
            "params": {
              "P": "Kp_etc",
              "I": "Ki_etc",
              "D": "Kd_etc",
              "N": 1000.0,
              "initial_integrator": 0.0,
              "upper": 1.0,
              "lower": -1.0,
              "anti_windup": "clamping",
              "Kb": 1.0,
              "sample_time": 0.001
            },
            "meta": {
              "position": [
                250.0,
                40.0
              ]
            }
          },
          {
            "name": "spring_ff",
            "type": "math.gain",
            "params": {
              "gain": "(k_spring * pi / 180) / n_gear * R_motor / k_motor / 12",
              "multiplication": "elementwise",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                250.0,
                150.0
              ]
            }
          },
          {
            "name": "duty_sum",
            "type": "math.sum",
            "params": {
              "signs": "++",
              "output_type": "inherit"
            },
            "meta": {
              "position": [
                400.0,
                80.0
              ]
            }
          },
          {
            "name": "duty",
            "type": "ports.outport",
            "params": {
              "port": 1
            },
            "meta": {
              "position": [
                520.0,
                80.0
              ]
            }
          }
        ],
        "connections": [
          {
            "src": "target_deg",
            "src_port": 0,
            "dst": "error",
            "dst_port": 0
          },
          {
            "src": "tps_deg",
            "src_port": 0,
            "dst": "error",
            "dst_port": 1
          },
          {
            "src": "error",
            "src_port": 0,
            "dst": "pid",
            "dst_port": 0
          },
          {
            "src": "target_deg",
            "src_port": 0,
            "dst": "spring_ff",
            "dst_port": 0
          },
          {
            "src": "pid",
            "src_port": 0,
            "dst": "duty_sum",
            "dst_port": 0
          },
          {
            "src": "spring_ff",
            "src_port": 0,
            "dst": "duty_sum",
            "dst_port": 1
          },
          {
            "src": "duty_sum",
            "src_port": 0,
            "dst": "duty",
            "dst_port": 0
          }
        ]
      }
    },
    {
      "name": "gnd",
      "type": "electrical.reference",
      "params": {},
      "meta": {
        "position": [
          330.0,
          260.0
        ]
      }
    },
    {
      "name": "battery",
      "type": "electrical.battery",
      "params": {
        "capacity": 60.0,
        "R_internal": 0.02,
        "soc0": 0.8,
        "soc_breakpoints": [
          0.0,
          0.2,
          0.5,
          0.8,
          1.0
        ],
        "ocv": [
          11.6,
