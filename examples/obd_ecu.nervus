  "tests": [
    {
      "name": "misfire: pending in the first cycle, MIL in the second",
      "description": "Cylinder 2 misfires from 20 s: pending at once, confirmed with the MIL after the second key cycle",
      "stop_time": 45.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "mil",
          "lower": 0.0,
          "upper": 0.0,
          "t_from": 0.0,
          "t_to": 29.0
        },
        {
          "kind": "bounds",
          "signal": "pending",
          "lower": 1.0,
          "upper": 1.0,
          "t_from": 22.0,
          "t_to": 29.0
        },
        {
          "kind": "final_value",
          "signal": "mil",
          "value": 1.0
        },
        {
          "kind": "final_value",
          "signal": "confirmed",
          "value": 1.0
        }
      ]
    },
    {
      "name": "lean monitor passes",
      "description": "The fuel trim is normal: P0171 completes (ready) and sets nothing",
      "stop_time": 10.0,
      "inputs": {},
      "checks": [
        {
          "kind": "final_value",
          "signal": "lean_ready",
          "value": 1.0
        }
      ]
    }
  ]
