  "tests": [
    {
      "name": "ABS keeps the wheel turning",
      "description": "With ABS the slip stays below 30 % after the first cycle: the wheel never locks and the car can steer",
      "stop_time": 4.0,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "wheel_slip",
          "upper": 0.3,
          "t_from": 0.7,
          "t_to": 3.0
        }
      ]
    },
    {
      "name": "without ABS the wheel locks",
      "description": "Full braking without ABS on a dry road locks the wheel within 0.2 s",
      "stop_time": 2.0,
      "parameters": {
        "abs_on": 0.0
      },
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
          "signal": "wheel_slip",
          "lower": 0.99,
          "t_from": 0.75,
          "t_to": 2.0
        }
      ]
    }
  ]
