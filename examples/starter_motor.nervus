  "tests": [
    {
      "name": "cranking",
      "description": "Inrush of several hundred amperes, the battery dips below 10 V, the engine cranks at 150-300 rpm",
      "stop_time": 1.5,
      "inputs": {},
      "checks": [
        {
          "kind": "bounds",
