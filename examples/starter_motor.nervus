      "params": {
        "code": "def f(t, phi):\n    \"\"\"Compression torque [N·m] of a 4-cylinder engine at crank angle phi: two peaks per revolution.\"\"\"\n    return p[0] * max(0.0, math.sin(2 * phi)) ** 2 + p[1]\n",
